<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/et_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="OpenAI API Key"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/et_target_lang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target Language (e.g., Japanese)" />

        <EditText
            android:id="@+id/et_html_input"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="HTML to translate"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:minLines="4" />

        <Button
            android:id="@+id/btn_translate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Translate" />

        <WebView
            android:id="@+id/webview_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
