{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: Run Flask (Hot Reload)",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "FLASK_APP": "run.py", 
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1",
                "GOOGLE_APPLICATION_CREDENTIALS": "${workspaceFolder}/backend/firebase-adminsdk-credentials.json"
            },
            "args": [
                "run",
                "--no-debugger" 
            ],
            "jinja": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe" 
        },
        {
            "name": "Backend: Debug Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "FLASK_APP": "run.py", 
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "0",
                "GOOGLE_APPLICATION_CREDENTIALS": "${workspaceFolder}/backend/firebase-adminsdk-credentials.json"
            },
            "args": [
                "run",
                "--no-reload" 
            ],
            "jinja": true,
            "python": "${workspaceFolder}/.venv/Scripts/python.exe" 
        },
        {
            "name": "Frontend: Vite Dev Server",
            "type": "node-terminal", 
            "request": "launch",
            "command": "npm run dev:frontend",
            "cwd": "${workspaceFolder}/frontend",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Full-Stack: Flask (Hot Reload) + Vite",
            "configurations": ["Backend: Run Flask (Hot Reload)", "Frontend: Vite Dev Server"],
            "stopAll": true,
            "presentation": {
                "group": "Full-Stack",
                "order": 1
            }
        },
        {
            "name": "Full-Stack: Debug Flask + Vite",
            "configurations": ["Backend: Debug Flask", "Frontend: Vite Dev Server"],
            "stopAll": true,
            "presentation": {
                "group": "Full-Stack",
                "order": 2
            }
        }
    ]
} 