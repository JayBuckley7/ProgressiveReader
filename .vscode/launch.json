{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Run Flask Dev Server (Debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "args": [],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "subProcess": true,
            "justMyCode": true,
            "env": {
                "FLASK_DEBUG": "1",
                "FLASK_APP": "run.py",
                "FLASK_ENV": "development"
            }
        },
        {
            "name": "Run Flask with Hot Reload (No Debug)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "env": {
                "FLASK_DEBUG": "1",
                "FLASK_APP": "run.py",
                "FLASK_ENV": "development"
            }
        },
        {
            "name": "Python: Generate EPUB Ground Truth",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/generate_epub_groundtruth.py",
            "console": "integratedTerminal",
            "args": [],
            "env": {},
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "npm: Run Development Watch",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Full-Stack: Server + Webpack",
            "configurations": ["Run Flask Dev Server (Debug)", "npm: Run Development Watch"],
            "stopAll": true,
            "presentation": {
                "hidden": false,
                "group": "fullstack",
                "order": 1
            }
        },
        {
            "name": "Full-Stack: Hot Reload + Webpack",
            "configurations": ["Run Flask with Hot Reload (No Debug)", "npm: Run Development Watch"],
            "stopAll": true,
            "presentation": {
                "hidden": false,
                "group": "fullstack",
                "order": 2
            }
        }
    ]
} 