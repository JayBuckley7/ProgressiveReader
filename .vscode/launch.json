{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Run & Debug Waitress Server",
            "type": "debugpy",
            "request": "launch",
            "module": "waitress",
            "args": [
                "--port=8080",
                "run:app"
            ],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "subProcess": true,
            "justMyCode": true
        },
        {
            "name": "Python: Generate EPUB Ground Truth",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/generate_epub_groundtruth.py",
            "console": "integratedTerminal",
            "args": [],
            "env": {},
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}"
        }
    ]
} 