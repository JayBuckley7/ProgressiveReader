{
  "name": "progressive-reader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "prebuild": "npm run types:generate",
    "build": "vite build",
    "lint": "tsc -p . --noEmit --pretty false && vite build",
    "eslint": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js src",
    "types:generate": "py ../scripts/generate_ts_types.py || python3 ../scripts/generate_ts_types.py || python ../scripts/generate_ts_types.py",
    "test": "npm run -s test:part1 && npm run -s test:part2",
    "test:part1": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs --run --exclude src/test/integration/reader.translate.test.tsx --exclude src/test/smoke/BookReader.test.tsx",
    "test:part2": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs --run src/test/smoke/BookReader.test.tsx src/test/integration/reader.translate.test.tsx",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.31.8",
    "@zip.js/zip.js": "^2.7.68",
    "clsx": "^2.1.1",
    "epubjs": "^0.3.93",
    "firebase": "^12.0.0",
    "htmlparser2": "^10.0.0",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "kuromoji": "^0.1.2",
    "pdfjs-dist": "^5.4.54",
    "i18next": "^23.16.6",
    "i18next-browser-languagedetector": "^8.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.5.2",
    "react-router-dom": "^6.22.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0",
    "tiny-segmenter": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "~10",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.15.0",
    "postcss": "~8",
    "tailwindcss": "~3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^2.1.5",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/jest-dom": "^6.6.3",
    "msw": "^2.6.4",
    "zod": "^3.23.8",
    "jsdom": "^24.1.3",
    "happy-dom": "^15.11.7"
  }
}
