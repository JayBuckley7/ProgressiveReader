{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./app/static/js/dist",
    "rootDir": "./src",
    "strict": true,
    "jsx": "react",
    "jsxFactory": "jsxCreateElement",
    "jsxFragmentFactory": "NOT_IMPLEMENTED",
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
} 