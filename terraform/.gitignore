# Terraform state files (local state should not be committed)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform lock file (can optionally be committed for consistent versions)
# Uncomment if you want to commit it:
# !.terraform.lock.hcl

# Exclude all provider plugins
.terraform/

# Exclude override files as they're usually used for local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Exclude tfvars files that may contain sensitive data
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Exclude CLI configuration files
.terraformrc
terraform.rc

# Backup files
*.backup
